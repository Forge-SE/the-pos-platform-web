{
  "name": "pos-platform",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "start": "srvx --prod --static dist --entry server.mjs",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint",
    "format": "prettier --write . --ignore-unknown",
    "check": "prettier --check . --ignore-unknown",
    "typecheck": "tsc --noEmit",
    "validate": "npm run check && npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@apollo/client": "^4.3.1",
    "@base-ui/react": "^1.8.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "framer-motion": "^13.4.0",
    "graphql": "^16.11.0",
    "graphql-ws": "^6.0.6",
    "input-otp": "^1.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rxjs": "^7.8.2",
    "shadcn": "^4.21.0",
    "srvx": "^1.0.5",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tanstack/devtools-vite": "latest",
    "@tanstack/eslint-config": "latest",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^9",
    "jsdom": "^30",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6",
    "vite": "^8",
    "vitest": "^4"
  }
}
