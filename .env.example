# Optional in local development. When omitted, browser requests use the Vite
# /graphql proxy.
# VITE_GRAPHQL_URL=https://api.example.com/graphql

# Optional. When omitted, the WebSocket URL is derived from VITE_GRAPHQL_URL
# (or the current browser origin when using the local /graphql proxy).
# VITE_GRAPHQL_WS_URL=wss://api.example.com/graphql
